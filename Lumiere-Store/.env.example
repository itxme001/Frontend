# ---------------------------------------------------------------
# Lumière — environment configuration
# Copy this file to `.env.local` and fill in real values.
# ---------------------------------------------------------------

# Secret used to sign authentication session cookies AND CSRF tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production — the app will throw on startup if missing.
AUTH_SECRET=replace-with-a-long-random-string

# Stripe secret key used to create Checkout Sessions on the server.
# Get it from https://dashboard.stripe.com/apikeys
# Leave blank to run checkout in demo mode (no real payments).
STRIPE_SECRET_KEY=

# Stripe webhook signing secret — set after creating a webhook in the Stripe dashboard.
# Used by /api/webhooks/stripe to verify incoming payment events.
STRIPE_WEBHOOK_SECRET=

# Currency for Stripe line items (lowercase ISO code).
STRIPE_CURRENCY=usd

# Resend API key for order confirmation emails (optional — emails are silent-failed if unset).
RESEND_API_KEY=

